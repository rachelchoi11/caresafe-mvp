{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    },

    "migrations": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
    },

    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "seniors_public": {
      ".read": true,
      ".write": "auth != null"
    },

    "seniors_private": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "seniors": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "alerts": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "activeUid": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "qr_index": {
      ".read": true,
      ".write": "auth != null"
    },

    "ping": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "ai_cache": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "med_logs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "med_alerts": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        "$dayKey": {
          "$slotKey": {
            ".validate": "newData.hasChild('firedAt') && newData.child('firedAt').isNumber()"
          }
        }
      }
    },

    "pilots": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
    }
  }
}
